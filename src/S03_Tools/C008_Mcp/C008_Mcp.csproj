<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Masque.Mcp</AssemblyName>
    <RootNamespace>Masque.Mcp</RootNamespace>
    <Description>masque-mcp: an MCP server that lets an AI assistant query CSV, Excel, SQLite and SQL Server tables and see only masked results, and change data through the same checks.</Description>
    <!-- Installable with `dotnet tool install`; the command is `masque-mcp`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>masque-mcp</ToolCommandName>
    <PackageId>Masque.Mcp</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Masque.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\S01_Core\C001_Core\C001_Core.csproj" />
    <ProjectReference Include="..\..\S01_Core\C002_Vault\C002_Vault.csproj" />
    <ProjectReference Include="..\..\S01_Core\C009_Data\C009_Data.csproj" />
    <ProjectReference Include="..\..\S02_Adapters\C003_Csv\C003_Csv.csproj" />
    <ProjectReference Include="..\..\S02_Adapters\C005_Excel\C005_Excel.csproj" />
    <ProjectReference Include="..\..\S02_Adapters\C006_Sqlite\C006_Sqlite.csproj" />
    <ProjectReference Include="..\..\S02_Adapters\C007_SqlServer\C007_SqlServer.csproj" />
  </ItemGroup>

</Project>
