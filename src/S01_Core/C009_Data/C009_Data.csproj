<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Masque.Data</AssemblyName>
    <RootNamespace>Masque.Data</RootNamespace>
    <Description>ADO.NET decorators that mask PII and PHI in query results: wrap a DbConnection (or register Masque with DI) and every query, including Dapper's, comes back with sensitive columns tokenized.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\C001_Core\C001_Core.csproj" />
    <ProjectReference Include="..\C002_Vault\C002_Vault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Masque.Data.Tests" />
    <InternalsVisibleTo Include="Masque.EntityFrameworkCore" />
  </ItemGroup>

</Project>
